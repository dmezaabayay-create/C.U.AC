import 'dart:io';
import 'package:flutter/material.dart';
import 'package:camera/camera.dart';
import 'package:google_mlkit_selfie_segmentation/google_mlkit_selfie_segmentation.dart';
import '../models/personaje.dart';
import '../helpers/database_helper.dart';
import 'batalla_screen.dart';

class CrearPersonajeScreen extends StatefulWidget {
  final List<CameraDescription> cameras;

  const CrearPersonajeScreen({super.key, required this.cameras});

  @override
  State<CrearPersonajeScreen> createState() => _CrearPersonajeScreenState();
}

class _CrearPersonajeScreenState extends State<CrearPersonajeScreen> {
  CameraController? _controller;
  final _nombreController = TextEditingController();
  String _especialidadSeleccionada = 'Guerrero';
  String? _imagePathCapturada;
  bool _procesandoIA = false;

  final List<String> _especialidades = ['Guerrero', 'Mago', 'Sanador', 'Asesino'];

  @override
  void initState() {
    super.initState();
    if (widget.cameras.isNotEmpty) {
      // Usar la cámara frontal por defecto para selfies
      final cameraFrontal = widget.cameras.firstWhere(
        (cam) => cam.lensDirection == CameraLensDirection.front,
        orElse: () => widget.cameras.first,
      );
      _controller = CameraController(cameraFrontal, ResolutionPreset.medium);
      _controller!.initialize().then((_) {
        if (!mounted) return;
        setState(() {});
      });
    }
  }

  @override
  void dispose() {
    _controller?.dispose();
    _nombreController.dispose();
    super.dispose();
  }

  Future<void> _tomarFotoYProcesar() async {
    if (_controller == null || !_controller!.value.isInitialized) return;

    try {
      setState(() => _procesandoIA = true);
      final XFile photo = await _controller!.takePicture();

      // Segmentación con ML Kit
      final inputImage = InputImage.fromFilePath(photo.path);
      final segmenter = SelfieSegmenter(
        mode: SegmenterMode.single,
        enableRawSizeMask: true,
      );

      final mask = await segmenter.processImage(inputImage);
      segmenter.close();

      setState(() {
        _imagePathCapturada = photo.path;
        _procesandoIA = false;
      });
    } catch (e) {
      setState(() => _procesandoIA = false);
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('Error al procesar selfie: $e')),
      );
    }
  }

  Future<void> _guardarYIrABatalla() async {
    if (_nombreController.text.trim().isEmpty || _imagePathCapturada == null) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Por favor ingresa un nombre y tómate la selfie.')),
      );
      return;
    }

    final nuevoPersonaje = Personaje(
      nombre: _nombreController.text.trim(),
      especialidad: _especialidadSeleccionada,
      imagePath: _imagePathCapturada!,
    );

    await DatabaseHelper.instance.insertPersonaje(nuevoPersonaje);

    if (!mounted) return;
    Navigator.push(
      context,
      MaterialPageRoute(
        builder: (context) => BatallaScreen(personaje: nuevoPersonaje),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF1E1E2C),
      appBar: AppBar(
        title: const Text('Crear Personaje CUACS'),
        backgroundColor: const Color(0xFF2D2D44),
      ),
      body: SingleChildScrollView(
        padding: const EdgeInsets.all(16),
        child: Column(
          children: [
            // ÁREA DE CÁMARA O PREVIEW
            Container(
              height: 300,
              width: double.infinity,
              decoration: BoxDecoration(
                color: Colors.black26,
                borderRadius: BorderRadius.circular(16),
                border: Border.all(color: Colors.white24),
              ),
              child: ClipRRect(
                borderRadius: BorderRadius.circular(16),
                child: _procesandoIA
                    ? const Center(child: CircularProgressIndicator(color: Colors.amber))
                    : _imagePathCapturada != null
                        ? Image.file(File(_imagePathCapturada!), fit: BoxFit.cover)
                        : _controller != null && _controller!.value.isInitialized
                            ? CameraPreview(_controller!)
                            : const Center(child: Text('Cámara no disponible', style: TextStyle(color: Colors.white))),
              ),
            ),
            const SizedBox(height: 12),
            ElevatedButton.icon(
              onPressed: _tomarFotoYProcesar,
              icon: const Icon(Icons.camera_alt),
              label: Text(_imagePathCapturada == null ? 'Tomar Selfie' : 'Repetir Foto'),
              style: ElevatedButton.styleFrom(backgroundColor: Colors.amber, foregroundColor: Colors.black),
            ),
            const SizedBox(height: 20),

            // FORMULARIO DE DATOS
            TextField(
              controller: _nombreController,
              style: const TextStyle(color: Colors.white),
              decoration: InputDecoration(
                labelText: 'Nombre del Héroe',
                labelStyle: const TextStyle(color: Colors.white70),
                filled: true,
                fillColor: const Color(0xFF2D2D44),
                border: OutlineInputBorder(borderRadius: BorderRadius.circular(12)),
              ),
            ),
            const SizedBox(height: 16),
            DropdownButtonFormField<String>(
              value: _especialidadSeleccionada,
              dropdownColor: const Color(0xFF2D2D44),
              style: const TextStyle(color: Colors.white),
              decoration: InputDecoration(
                labelText: 'Especialidad',
                labelStyle: const TextStyle(color: Colors.white70),
                filled: true,
                fillColor: const Color(0xFF2D2D44),
                border: OutlineInputBorder(borderRadius: BorderRadius.circular(12)),
              ),
              items: _especialidades.map((esp) {
                return DropdownMenuItem(value: esp, child: Text(esp));
              }).toList(),
              onChanged: (val) {
                if (val != null) setState(() => _especialidadSeleccionada = val);
              },
            ),
            const SizedBox(height: 24),

            // BOTÓN GUARDAR
            SizedBox(
              width: double.infinity,
              height: 50,
              child: ElevatedButton(
                onPressed: _guardarYIrABatalla,
                style: ElevatedButton.styleFrom(
                  backgroundColor: Colors.greenAccent,
                  foregroundColor: Colors.black,
                  shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                ),
                child: const Text('¡Guardar e Iniciar Batalla!', style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

