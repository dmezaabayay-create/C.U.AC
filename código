import 'package:sqflite/sqflite.dart';
import 'package:path/path.dart';
import '../models/personaje.dart';

class DatabaseHelper {
  static final DatabaseHelper instance = DatabaseHelper._init();
  static Database? _database;

  DatabaseHelper._init();

  Future<Database> get database async {
    if (_database != null) return _database!;
    _database = await _initDB('personajes.db');
    return _database!;
  }

  Future<Database> _initDB(String filePath) async {
    final dbPath = await getDatabasesPath();
    final path = join(dbPath, filePath);

    return await openDatabase(
      path,
      version: 1,
      onCreate: _createDB,
    );
  }

  Future _createDB(Database db, int version) async {
    await db.execute('''
      CREATE TABLE personajes (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        nombre TEXT NOT NULL,
        especialidad TEXT NOT NULL,
        imagePath TEXT NOT NULL
      )
    ''');
  }

  Future<int> insertPersonaje(Personaje personaje) async {
    final db = await instance.database;
    return await db.insert('personajes', personaje.toMap());
  }

  Future<List<Personaje>> getPersonajes() async {
    final db = await instance.database;
    final result = await db.query('personajes');
    return result.map((json) => Personaje.fromMap(json)).toList();
  }
}

