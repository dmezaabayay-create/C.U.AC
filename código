import 'dart:io';
import 'package:flutter/material.dart';
import '../models/personaje.dart';

class BatallaScreen extends StatefulWidget {
  final Personaje personaje;

  const BatallaScreen({super.key, required this.personaje});

  @override
  State<BatallaScreen> createState() => _BatallaScreenState();
}

class _BatallaScreenState extends State<BatallaScreen> {
  double jugadorHp = 1.0;
  double enemigoHp = 1.0;
  bool personajeRecibeDano = false;
  String mensajeBatalla = "¡Que comience el combate!";

  final List<Map<String, dynamic>> habilidades = [
    {'nombre': 'Ataque Físico', 'icono': Icons.flash_on, 'color': Colors.orange, 'dano': 0.15},
    {'nombre': 'Fuego Arcano', 'icono': Icons.local_fire_department, 'color': Colors.redAccent, 'dano': 0.25},
    {'nombre': 'Curación', 'icono': Icons.favorite, 'color': Colors.green, 'dano': -0.20},
    {'nombre': 'Golpe Crítico', 'icono': Icons.sports_mma, 'color': Colors.purpleAccent, 'dano': 0.35},
  ];

  void usarHabilidad(Map<String, dynamic> hab) {
    if (enemigoHp <= 0 || jugadorHp <= 0) return;

    setState(() {
      double dano = hab['dano'];
      if (dano < 0) {
        jugadorHp = (jugadorHp - dano).clamp(0.0, 1.0);
        mensajeBatalla = "${widget.personaje.nombre} usó ${hab['nombre']} y recuperó vida.";
      } else {
        enemigoHp = (enemigoHp - dano).clamp(0.0, 1.0);
        personajeRecibeDano = true;
        mensajeBatalla = "¡${widget.personaje.nombre} usó ${hab['nombre']} causando daño!";
      }
    });

    Future.delayed(const Duration(milliseconds: 300), () {
      if (mounted) setState(() => personajeRecibeDano = false);
    });

    // Contraataque del enemigo
    if (enemigoHp > 0) {
      Future.delayed(const Duration(seconds: 1), () {
        if (!mounted) return;
        setState(() {
          jugadorHp = (jugadorHp - 0.10).clamp(0.0, 1.0);
          mensajeBatalla = "¡El Enemigo contraataca!";
        });
      });
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF1E1E2C),
      appBar: AppBar(
        title: const Text('Arena de Combate'),
        backgroundColor: const Color(0xFF2D2D44),
      ),
      body: Column(
        children: [
          Expanded(
            flex: 3,
            child: Container(
              margin: const EdgeInsets.all(12),
              padding: const EdgeInsets.all(16),
              decoration: BoxDecoration(
                color: const Color(0xFF2D2D44),
                borderRadius: BorderRadius.circular(16),
                border: Border.all(color: Colors.white24),
              ),
              child: Column(
                mainAxisAlignment: MainAxisAlignment.spaceAround,
                children: [
                  // ENEMIGO
                  _buildTarjeta(
                    nombre: "Sombra Oscura",
                    hp: enemigoHp,
                    colorHp: Colors.redAccent,
                    child: const CircleAvatar(radius: 28, backgroundColor: Colors.redAccent, child: Icon(Icons.bug_report, size: 32, color: Colors.white)),
                  ),

                  // TEXTO MENSAJE
                  Text(
                    mensajeBatalla,
                    style: const TextStyle(color: Colors.amber, fontSize: 15, fontWeight: FontWeight.bold),
                    textAlign: TextAlign.center,
                  ),

                  // JUGADOR CON SU SELFIE
                  AnimatedScale(
                    scale: personajeRecibeDano ? 1.1 : 1.0,
                    duration: const Duration(milliseconds: 150),
                    child: _buildTarjeta(
                      nombre: "${widget.personaje.nombre} (${widget.personaje.especialidad})",
                      hp: jugadorHp,
                      colorHp: Colors.greenAccent,
                      child: ClipRRect(
                        borderRadius: BorderRadius.circular(30),
                        child: Image.file(
                          File(widget.personaje.imagePath),
                          width: 56,
                          height: 56,
                          fit: BoxFit.cover,
                        ),
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ),

          // PANEL DE HABILIDADES
          Expanded(
            flex: 2,
            child: Container(
              padding: const EdgeInsets.all(12),
              child: GridView.builder(
                physics: const NeverScrollableScrollPhysics(),
                gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
                  crossAxisCount: 2,
                  childAspectRatio: 2.2,
                  crossAxisSpacing: 10,
                  mainAxisSpacing: 10,
                ),
                itemCount: habilidades.length,
                itemBuilder: (context, index) {
                  final hab = habilidades[index];
                  return ElevatedButton.icon(
                    style: ElevatedButton.styleFrom(
                      backgroundColor: hab['color'],
                      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
                    ),
                    icon: Icon(hab['icono'], color: Colors.white, size: 24),
                    label: Text(hab['nombre'], style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),
                    onPressed: () => usarHabilidad(hab),
                  );
                },
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildTarjeta({required String nombre, required double hp, required Color colorHp, required Widget child}) {
    return Row(
      children: [
        child,
        const SizedBox(width: 12),
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(nombre, style: const TextStyle(color: Colors.white, fontWeight: FontWeight.bold)),
              const SizedBox(height: 6),
              ClipRRect(
                borderRadius: BorderRadius.circular(8),
                child: LinearProgressIndicator(value: hp, minHeight: 12, backgroundColor: Colors.black48, color: colorHp),
              ),
              Text("${(hp * 100).toInt()}% HP", style: const TextStyle(color: Colors.white70, fontSize: 12)),
            ],
          ),
        ),
      ],
    );
  }
}

