lib/models.dart

class Personaje {
  final int? id;
  final String nombre;
  final String especialidad;
  final String imagePath;

  Personaje({
    this.id,
    required this.nombre,
    required this.especialidad,
    required this.imagePath,
  });

  Map<String, dynamic> toMap() {
    return {
      'id': id,
      'nombre': nombre,
      'especialidad': especialidad,
      'imagePath': imagePath,
    };
  }

  factory Personaje.fromMap(Map<String, dynamic> map) {
    return Personaje(
      id: map['id'],
      nombre: map['nombre'],
      especialidad: map['especialidad'],
      imagePath: map['imagePath'],
    );
  }
}

Está define la estructura de la clase Personaje osea el nombre, especialidad etc y contiene los métodos para convertir el objeto a un Map y viceversa asi que permite guardar la información en formato compatible con la base de datos.


lib/helpers.dart

import 'package:sqflite/sqflite.dart';
import 'package:path/path.dart';
import '../models/personaje.dart';

class DatabaseHelper {
  static final DatabaseHelper instance = DatabaseHelper._init();
  static Database? _database;

  DatabaseHelper._init();

  Future<Database> get database async {
    if (_database != null) return _database!;
    _database = await _initDB('personajes.db');
    return _database!;
  }

  Future<Database> _initDB(String filePath) async {
    final dbPath = await getDatabasesPath();
    final path = join(dbPath, filePath);

    return await openDatabase(
      path,
      version: 1,
      onCreate: _createDB,
    );
  }

  Future _createDB(Database db, int version) async {
    await db.execute('''
      CREATE TABLE personajes (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        nombre TEXT NOT NULL,
        especialidad TEXT NOT NULL,
        imagePath TEXT NOT NULL
      )
    ''');
  }

  Future<int> insertPersonaje(Personaje personaje) async {
    final db = await instance.database;
    return await db.insert('personajes', personaje.toMap());
  }

  Future<List<Personaje>> getPersonajes() async {
    final db = await instance.database;
    final result = await db.query('personajes');
    return result.map((json) => Personaje.fromMap(json)).toList();
  }
}
Este controla el almacenamiento local con SQLite y Se encarga de crear la tabla en la app y ofrece las funciones para capturar nuevos personajes y recuperar la lista guardada.


